upstream_timeout = "3m"
max_request_body = "2m"

[ollama]
endpoint_anthropic = "http://host.docker.internal:11434"
models = "gemma4:31b"
max_tokens = 10_000
max_output_tokens = 10_000
max_completion_tokens = 10_000

[deepseek]
endpoint_anthropic = "https://api.deepseek.com/anthropic"
api_key = "${DEEPSEEK_API_KEY}"
models = ["deepseek-v4-pro", "deepseek-v4-flash"]

[etc]
endpoint_openai = "https://api.modelarts-maas.com/openai/v1"
api_key = "${MAAS_API_KEY}"
models = "default"
# openai-related settings:
max_tokens = 10_000
max_output_tokens = 10_000
max_completion_tokens = 10_000

[diagnostics]
# Куда писать NDJSON статистики: "stderr" (по умолчанию), "stdout", или путь к файлу.
stats_output = "/app/logs/diag.ndjson"

# Куда писать NDJSON дампа: "stderr" (по умолчанию), "stdout", или путь к файлу.
dump_output = "/app/logs/dump.ndjson"

# Статистика (сводка по каждому запросу: модель, длительность, количество токенов, разбор сообщений):
# "off" — не собирать; "error" — только при ошибках; "all" — каждый запрос.
stats_mode = "all"

# Дамп тел запросов и ответов (для отладки, может быть объёмным):
# "off" — не дампить; "error" — только при ошибках; "all" — каждый запрос.
dump_mode = "error"

# Максимальный размер текущего файла, после которого происходит ротация
# (создаётся dump-2026-06-09-001.ndjson, пишется новый файл).
# Суффиксы: k (килобайты), m (мегабайты), g (гигабайты). Отсутствие опции — без ротации.
#max_file_size = "100m"

# Максимальный суммарный размер всех ротированных (старых) файлов.
# При превышении самые старые удаляются. Отсутствие опции — без ограничения.
#max_rotated_size = "5g"

# Сжатие ротированных файлов: "zip" | "bz2" | "7z".
# Выполняется в отдельном потоке, не блокирует запись.
# Отсутствие опции — без сжатия.
#compression = "zip"

# Разделять diagnostic-файлы по endpoint'ам (секциям конфига).
# Вместо строки — таблица { per_section = "путь" }.
# Будут создаваться файлы вида diag-ollama.ndjson,
# dump-deepseek-2026-06-09-001.ndjson.zip и т.д.
#stats_output = { per_section = "diag.ndjson" }
#dump_output = { per_section = "dump.ndjson" }
